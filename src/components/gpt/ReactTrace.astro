---
// Interactive ReAct trace stepper — walk a Reason/Act/Observe loop step by step.
import '../../styles/gpt-widgets.css';
---

<figure class="gpt-figure">
  <div class="gpt-root" data-gpt-react></div>
  <slot />
</figure>

<script>
  import { mountReactTrace } from '../../scripts/gpt/agents.js';
  document.querySelectorAll('[data-gpt-react]').forEach((el) => mountReactTrace(el));
</script>
